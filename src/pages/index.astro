---
import { readFile } from 'node:fs/promises';
import { join } from 'node:path';
import '@fontsource/imbue/latin-400.css';
import '@fontsource/albert-sans/latin-400.css';
import '@fontsource/albert-sans/latin-600.css';
import imbueUrl from '@fontsource/imbue/files/imbue-latin-400-normal.woff2?url';
import '../styles/global.css';
import Story from '../components/Story.astro';
import { DATA_URL, parseArtifact } from '../lib/rainfall';
import { buildClaims, fmt } from '../lib/story';
import { legendModel } from '../lib/colour';

const artifact = parseArtifact(JSON.parse(await readFile(join(process.cwd(), 'public', DATA_URL), 'utf8')));
const claims = buildClaims(artifact);
const audit = artifact.provenance.source_audit;
const cellCount = fmt.count(artifact.cells.count);
const PAGASA = 'https://pubfiles.pagasa.dost.gov.ph/pagasaweb/files/climate/elninolanina/EN_Advisory_5.pdf';
const description = `${claims['standfirst-enso'].text} ${claims['standfirst-trend'].text} NASA IMERG rainfall over the Philippines, 2001-2025.`;
const ensoClasses = legendModel(artifact, 'enso', artifact.period.start).classes;
const yearClasses = legendModel(artifact, 'year', artifact.period.start).classes;
const ensoStops = artifact.legend.enso_pct.slice(1, -1);
const yearStops = artifact.legend.year_pct.slice(1, -1);
const minCol = Math.min(...artifact.cells.col);
const maxCol = Math.max(...artifact.cells.col);
const minRow = Math.min(...artifact.cells.row);
const maxRow = Math.max(...artifact.cells.row);
const cellWidth = maxCol - minCol + 1;
const cellHeight = maxRow - minRow + 1;
const cellPaths = ensoClasses.map(({ colour }) => ({ colour, d: '' }));
for (let index = 0; index < artifact.cells.count; index += 1) {
  const value = artifact.cells.jan_apr_enso_diff_pct[index]!;
  const nextBreak = ensoStops.findIndex((stop) => value < stop);
  const colourClass = nextBreak === -1 ? cellPaths.length - 1 : nextBreak;
  const x = artifact.cells.col[index]! - minCol;
  const y = maxRow - artifact.cells.row[index]!;
  cellPaths[colourClass]!.d += `M${x} ${y}h1v1h-1z`;
}
const januarySquares = artifact.period.years.map((year, index) => {
  const anomaly = artifact.national.jan_apr.anomaly_pct[index]!;
  const nextBreak = yearStops.findIndex((stop) => anomaly < stop);
  const colourClass = nextBreak === -1 ? yearClasses.length - 1 : nextBreak;
  return { year, anomaly, colour: yearClasses[colourClass]!.colour, elNino: artifact.enso.began_el_nino[index] };
});
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>Ulan, measured. Philippine rainfall from NASA IMERG, 2001-2025</title>
    <link rel="icon" href="data:," />
    <link rel="preload" as="font" type="font/woff2" href={imbueUrl} crossorigin />
  </head>
  <body>
    <a class="skip-link" href="#explore">Skip to the map explorer</a>
    <header class="site-header">
      <a class="wordmark" href="#top" lang="fil">Ulan</a>
      <nav class="tab" aria-label="Page">
        <a href="#story">Story</a>
        <a href="#explore">Explore</a>
        <a href="#method">Method</a>
      </nav>
      <button type="button" class="button button-primary header-action" data-find disabled>Find your square</button>
    </header>

    <main id="top">
      <section class="masthead" aria-labelledby="title">
        <div class="mosaic">
          <img class="tile tile-lando" src="/images/lando-imerg-2015.png" width="720" height="538" fetchpriority="high"
            alt="Satellite rainfall map of Typhoon Lando, 16 to 21 October 2015, brightest over northern Luzon." />
          <span class="tile tile-ink" aria-hidden="true"></span>
          <img class="tile tile-p23" src="/images/pantabangan-2023.jpg" width="720" height="480"
            alt="Pantabangan Lake from Landsat, 29 April 2023." />
          <span class="tile tile-yellow" aria-hidden="true"></span>
          <img class="tile tile-pampanga" src="/images/pampanga-flood-2015.jpg" width="720" height="480"
            alt="Muddy flood water along the Pampanga River and sediment plumes in Manila Bay, 21 October 2015." />
          <span class="tile tile-surface" aria-hidden="true"></span>
          <img class="tile tile-p24" src="/images/pantabangan-2024.jpg" width="720" height="480"
            alt="Pantabangan Lake from Landsat, 15 April 2024, with lower water and exposed shores." />
          <span class="tile tile-ink2" aria-hidden="true"></span>
          <span class="tile tile-surface2" aria-hidden="true"></span>
        </div>
        <div class="title-block">
          <h1 id="title" class="title"><span class="title-line"><span><span lang="fil">Ulan</span>,</span></span><span class="title-line"><span>measured</span></span></h1>
          <p class="standfirst">
            NASA satellite rain over the Philippines, 2001 to 2025, in {cellCount} squares.{' '}
            <span data-claim={claims['standfirst-enso'].id} data-verdict={claims['standfirst-enso'].verdict}>{claims['standfirst-enso'].text}</span>{' '}
            <span data-claim={claims['standfirst-trend'].id} data-verdict={claims['standfirst-trend'].verdict}>{claims['standfirst-trend'].text}</span>
          </p>
          <p class="actions">
            <button type="button" class="button button-primary" data-find disabled>Find your square</button>
            <a href={DATA_URL} download>Download the data</a>
          </p>
          <figure class="hero-cells">
            <svg viewBox={`0 0 ${cellWidth} ${cellHeight}`} width={cellWidth} height={cellHeight} role="img"
              aria-label="Philippine IMERG cells coloured by January to April rainfall differences in El Niño-start years">
              {cellPaths.map(({ colour, d }) => <path fill={colour} d={d} />)}
            </svg>
            <figcaption>Each square is one IMERG cell. Brown means less January to April rain in El Niño-start years.</figcaption>
          </figure>
          <p class="mosaic-credit">Pictures, left to right: Typhoon Lando's rain from IMERG, NASA Earth Observatory map by Joshua Stevens and Jesse Allen. Pantabangan Lake in 2023 and 2024, NASA Earth Observatory images by Michala Garrison, using Landsat data from the U.S. Geological Survey. The Pampanga River in flood, NASA Earth Observatory image by Joshua Stevens, using data from LANCE/EOSDIS Rapid Response.</p>
        </div>
      </section>

      <section class="intro" aria-label="Why this page looks back">
        <p class="statement" data-reveal>PAGASA's El Niño <a href={PAGASA}>Advisory No. 5</a>, issued on 7 October 2026, says this El Niño may last into the first half of 2027 and raises the chance of dry spells and drought. This page does not forecast. It looks back at 25 years of satellite rain to show what changed, and what earlier El Niño years were like.</p>
        <figure class="january-years" data-reveal>
          <ol class="january-squares" aria-label="National January to April rainfall anomalies">
            {januarySquares.map(({ year, anomaly, colour, elNino }) => (
              <li style={`--square-colour:${colour}`} data-el-nino={elNino}
                aria-label={`${year}, ${anomaly.toFixed(1)}% against the 25-year average${elNino ? ', began in El Niño' : ''}`}>
                <span class="visually-hidden">{year}, {anomaly.toFixed(1)}%{elNino ? ', began in El Niño' : ''}</span>
              </li>
            ))}
          </ol>
          <div class="chart-ticks" aria-hidden="true">
            {[2001, 2010, 2020, 2025].map((year) => <span style={`--tick-left:${(year - 2001 + 0.5) / 25 * 100}%`}>{year}</span>)}
          </div>
          <figcaption>Each square is one January to April, 2001 to 2025, against its 25-year average. Marked squares began in El Niño.</figcaption>
        </figure>
        <figure class="intro-figure" data-reveal>
          <img src="/images/cagayan-flood-2020.jpg" width="720" height="480" loading="lazy"
            alt="Northern Luzon from space with the brown, swollen Cagayan River running north past Tuguegarao to Aparri." />
          <figcaption>The Cagayan River in flood on 18 November 2020, after Typhoon Vamco (Ulysses). A flood picture records one event, not a trend. NASA Earth Observatory image by Joshua Stevens, using MODIS data from NASA EOSDIS/LANCE and GIBS/Worldview.</figcaption>
        </figure>
      </section>

      <Story artifact={artifact} claims={claims} />

      <section class="method" id="method" aria-labelledby="method-heading">
        <h2 id="method-heading" class="visually-hidden">Method</h2>
        <ol class="staircase">
          <li data-reveal><p class="stair">First, satellites watch the rain.</p><p>IMERG Final Run merges microwave and infrared satellite estimates with monthly rain gauges on a 0.1° grid.</p></li>
          <li data-reveal><p class="stair">Then we add each square's days.</p><p data-claim={claims['method-totals'].id} data-verdict={claims['method-totals'].verdict}>{claims['method-totals'].text}</p></li>
          <li data-reveal><p class="stair">We read the air separately.</p><p>MERRA-2 T2M estimates mean air temperature at 2 m using a model and observations. We weight monthly means by each month's calendar days, including leap days, to form annual and January to April means. The map keeps its native {artifact.air.grid.lat_step}° latitude by {artifact.air.grid.lon_step}° longitude cells. National and regional averages use the land area intersecting each cell, with a latitude correction, not smaller invented pixels. <a href="https://power.larc.nasa.gov/docs/services/api/temporal/monthly/">NASA POWER monthly API</a> and <a href="https://gmao.gsfc.nasa.gov/merra/">NASA MERRA-2</a> describe the source.</p></li>
          <li data-reveal><p class="stair">Then we find the farms.</p><p>MODIS land cover for {artifact.farm.mask_year} marks cropland on a 500 m grid. We keep the {artifact.farm.sites.length} densest cropland areas, at least 1° apart, and read MODIS surface temperature over their cropland, by day and by night, for every 8-day window from January to April. Each site gets one daytime and one night value per year.</p></li>
          <li data-reveal><p class="stair">We take the middle slope.</p><p>Sen's slope is the median of the 300 slopes between every pair of years, for each square's rain and each farm's temperature, so one unusual year moves it less than it would move a straight-line fit.</p></li>
          <li data-reveal><p class="stair">Last, we test the ordering of years.</p><p>The Mann-Kendall test gives p. Under its no-monotonic-trend model and assumptions, p measures how unusual a test statistic at least this extreme would be. Below 0.05 meets our test. It is not the probability that the no-trend model is true, or that chance caused the result. The test assumes independent years.</p></li>
        </ol>
        <section class="method-notes" aria-labelledby="notes-heading">
          <div class="notes-heading">
            <h2 id="notes-heading">The fine print</h2>
            <p>What these numbers can and cannot say.</p>
          </div>
          <details class="glossary" data-glossary>
            <summary>Plain-language glossary</summary>
            <dl>
              <dt>Precipitation, in millimetres</dt><dd>Rainfall totals measure the depth of collected water. One millimetre equals one litre over one square metre. Annual totals add the year's rain; January to April totals add only those months.</dd>
              <dt>Mean air temperature at 2 m, T2M</dt><dd>The average temperature of air two metres above the ground. MERRA-2 is a reanalysis, a reconstruction that combines observations with a weather model. Its coarse cells do not resolve every town or mountain.</dd>
              <dt>MODIS surface temperature</dt><dd>The satellite estimates the temperature of the ground surface when skies are clear enough to observe it. Day and night observations are separate. This is not the temperature of the air or a daily maximum or minimum.</dd>
              <dt>Cropland snapshot</dt><dd>The 2020 land-cover map identifies pixels classified as cropland. It does not measure crop yield, irrigation or changing farm boundaries. The 12 sites are a sample, not all Philippine farms.</dd>
              <dt>Anomaly and baseline</dt><dd>An anomaly is a difference from a reference average. Here the baseline is 2001-2025 for the same place, variable and time window. Rain anomalies are percentages of that mean; temperature anomalies are differences in °C, never Celsius percentages.</dd>
              <dt>Sen slope</dt><dd>Take the slope between every pair of years and choose the middle one. We report that fitted change per decade. It describes the record, not the amount that every year changes or a forecast.</dd>
              <dt>Mann-Kendall p-value</dt><dd>This test looks for a consistently rising or falling ordering of values. Assuming no monotonic trend and independent years, p measures how unusual a statistic at least this extreme would be. It is not the probability that the assumption is true. Our unadjusted 0.05 cutoff does not correct for testing many locations.</dd>
              <dt>ONI and El Niño-start years</dt><dd>ONI measures a three-month sea-surface-temperature anomaly in the tropical Pacific. This page groups years whose December-January-February ONI is at least +0.5 °C. That simple comparison rule is not the official full episode definition, which also considers persistence.</dd>
            </dl>
          </details>
          <p class="note" data-season-method>Comparing January to April every year holds the calendar window constant. It is not full seasonal adjustment or deseasonalization. These months are not uniformly dry across the Philippines, and weather, ENSO timing and other influences still vary within them.</p>
          <div class="notes-columns">
            <p data-claim={claims['method-weights'].id} data-verdict={claims['method-weights'].verdict}>{claims['method-weights'].text}</p>
            <p data-claim={claims['method-enso'].id} data-verdict={claims['method-enso'].verdict}>{claims['method-enso'].text}</p>
            <p data-claim={claims['method-limits'].id} data-verdict={claims['method-limits'].verdict}>{claims['method-limits'].text}</p>
            <p data-claim="method-farm" data-verdict={claims['method-farm'].verdict}>{claims['method-farm'].text}</p>
            <p data-claim="farm-limit" data-verdict={claims['farm-limit'].verdict}>{claims['farm-limit'].text}</p>
            <details class="why-imerg">
              <summary>Why we use IMERG</summary>
              <p>We first built this map from NASA POWER's MERRA-2 rainfall, and checked it against IMERG at one point near Manila.</p>
              <p data-claim={claims.audit.id} data-verdict={claims.audit.verdict}>{claims.audit.text}</p>
              <p>{artifact.enso.years.includes(audit.max_ratio_year) ? `${audit.max_ratio_year} began in El Niño, so that one year would have bent both the trend and the El Niño comparison.` : 'That one year would have bent the trend.'} We rebuilt the rainfall analysis on IMERG. We do not use MERRA-2 rainfall elsewhere on this page. The separate T2M air-temperature analysis uses MERRA-2. This one-point rainfall audit neither invalidates the whole reanalysis nor establishes agreement between the datasets.</p>
              <table class="audit-table">
                <caption>Annual rain at {fmt.lon(audit.point[0])}, {fmt.lat(audit.point[1])}, from NASA POWER point requests</caption>
                <thead><tr><th scope="col">Year</th><th scope="col">MERRA-2</th><th scope="col">IMERG</th><th scope="col">Ratio</th></tr></thead>
                <tbody>
                  {audit.years.map((year, index) => (
                    <tr data-audit-year={year}><th scope="row">{year}</th><td>{fmt.mm(audit.merra2_mm[index] ?? 0)}</td><td>{fmt.mm(audit.imerg_mm[index] ?? 0)}</td><td>{(audit.ratio[index] ?? 0).toFixed(2)}</td></tr>
                  ))}
                </tbody>
              </table>
            </details>
          </div>
        </section>
      </section>

      <section class="sources" aria-labelledby="sources-heading">
        <h2 id="sources-heading" class="sources-heading">Sources</h2>
        <div class="source-columns">
          <ul>
            <li class="source-kind">Data</li>
            <li><a href="https://gpm.nasa.gov/data/imerg">NASA GPM IMERG Final Run</a></li>
            <li><a href="https://power.larc.nasa.gov/docs/services/api/temporal/monthly/">NASA POWER monthly API, MERRA-2 T2M</a></li>
            <li><a href="https://gmao.gsfc.nasa.gov/merra/">NASA MERRA-2 reanalysis</a></li>
            <li><a href="https://www.cpc.ncep.noaa.gov/products/analysis_monitoring/ensostuff/ONI_v5.php">NOAA CPC Oceanic Niño Index</a></li>
            <li><a href="https://www.geoboundaries.org/">geoBoundaries PHL ADM0 and ADM1</a>, <a href="https://creativecommons.org/licenses/by/3.0/igo/">CC BY 3.0 IGO</a></li>
            <li><a href="https://doi.org/10.5067/MODIS/MCD12Q1.061">LP DAAC MCD12Q1 land cover</a>, Friedl and Sulla-Menashe (2022)</li>
            <li><a href="https://doi.org/10.5067/MODIS/MOD11A2.061">LP DAAC MOD11A2 surface temperature</a>, Wan, Hook and Hulley (2021)</li>
            <li><a href="https://modis.ornl.gov/rst/api/v1/">ORNL DAAC MODIS subset API</a></li>
          </ul>
          <ul>
            <li class="source-kind">Map</li>
            <li><a href="https://openfreemap.org/">OpenFreeMap</a></li>
            <li><a href="https://openmaptiles.org/">OpenMapTiles</a></li>
            <li><a href="https://www.openstreetmap.org/copyright">OpenStreetMap contributors</a></li>
            <li><a href="https://maplibre.org/">MapLibre GL JS</a></li>
          </ul>
          <ul>
            <li class="source-kind">Pictures</li>
            <li><a href="https://science.nasa.gov/earth/earth-observatory/extreme-rainfall-in-the-philippines-86857/">NASA Earth Observatory, Typhoon Lando</a></li>
            <li><a href="https://science.nasa.gov/earth/earth-observatory/flooding-in-northern-luzon-147554/">NASA Earth Observatory, Cagayan flood</a></li>
            <li><a href="https://science.nasa.gov/earth/earth-observatory/water-levels-plunge-in-philippine-reservoir-152787/">NASA Earth Observatory, Pantabangan Lake</a></li>
            <li>Joshua Stevens, Jesse Allen, Michala Garrison, USGS Landsat, NASA EOSDIS LANCE and GIBS/Worldview</li>
          </ul>
          <ul>
            <li class="source-kind">Context</li>
            <li><a href={PAGASA}>PAGASA El Niño Advisory No. 5</a></li>
            <li><a href="https://doi.org/10.1073/pnas.0403720101">Peng et al. (2004), rice yield and night air temperature at IRRI</a></li>
            <li><a href="https://fonts.google.com/specimen/Imbue">Imbue</a> and <a href="https://fonts.google.com/specimen/Albert+Sans">Albert Sans</a>, SIL Open Font License</li>
          </ul>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <div class="footer-columns">
        <p><a href="#story">Story</a><br /><a href="#explore">Explore</a><br /><a href="#method">Method</a></p>
        <p><a href={DATA_URL} download>Download the data (JSON)</a></p>
        <p>Made for NASA Space Apps 2026, Be An Earth System Trend Detective.</p>
      </div>
      <svg class="footer-wordmark" viewBox="0 0 400 100" role="img" aria-label="Ulan"><text x="0" y="92" textLength="400" lengthAdjust="spacingAndGlyphs">ULAN</text></svg>
      <p class="footer-note">Not affiliated with or endorsed by NASA, NOAA or PAGASA.</p>
    </footer>
    <script>
      import '../scripts/reveal';
    </script>
  </body>
</html>
